rules_version = '2';
// Standalone Storage rules for a site that only uses the blog. If the project
// already has rules, copy the /blog-images block into its existing file.
service firebase.storage {
  match /b/{bucket}/o {
    match /blog-images/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.admin == true
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
