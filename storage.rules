rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Business logos uploaded by members from member.html.
    match /business-logos/{uid}/{fileName} {
      allow read: if true;
      // SVG is intentionally not allowed (it can carry scripts).
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Blog images (blog-module/), uploaded from the editor at /blog-admin by accounts with the
    // `admin: true` claim. SVG is refused here too.
    match /blog-images/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.admin == true
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
