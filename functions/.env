# Non-secret settings for the Cloud Functions (secrets live in Secret Manager / .secret.local, never here).
# "From" address on reminder and notice emails. Must be an address your email provider allows you to send from.
# With SMTP_URL=gmail, the address must be the main address of a Google Workspace mailbox (the service account
# sends as that mailbox). Keep the organization's name in quotes: it's the sender name people see.
MAIL_FROM="A Rai of Sunshine of North Florida" <notifications@root-foundry.com>

# Where replies go (the organization's inbox, so "just reply to this email" reaches them).
MAIL_REPLY_TO=araiofsunshineofnorthflorida@gmail.com
# Service account with Gmail domain-wide delegation, used only when SMTP_URL=gmail.
GMAIL_SERVICE_ACCOUNT=mailer@araiofsunshine.iam.gserviceaccount.com
